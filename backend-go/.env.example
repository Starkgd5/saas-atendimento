# ============================================
# BANCO DE DADOS
# ============================================
DB_DSN=root:root123@tcp(localhost:3306)/saas_atendimento?parseTime=true&charset=utf8mb4
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5

# ============================================
# REDIS
# ============================================
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SERVIDOR
# ============================================
SERVER_PORT=:8080
GIN_MODE=debug  # debug, release, test
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60

# ============================================
# JWT
# ============================================
JWT_SECRET=supersecretkey123
JWT_EXPIRATION=24  # horas

# ============================================
# WHATSAPP API
# ============================================
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAA...seu_token_aqui
WHATSAPP_VERIFY_TOKEN=seu_verify_token_secreto
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_URL=/api/v1/webhook/whatsapp

# ============================================
# IA SERVICE
# ============================================
IA_ENABLED=true
IA_URL=http://ia-service:8001
IA_TIMEOUT=30
IA_MAX_RETRIES=3
IA_MODEL_PATH=/models/llama-2-7b.Q4_K_M.gguf
IA_LIMITE_AUTO=500.00

# ============================================
# FILA
# ============================================
MAX_CLIENTS=3

# ============================================
# SEGURANÇA
# ============================================
BCRYPT_COST=10
RATE_LIMIT=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# LOG
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text
LOG_OUTPUT=stdout  # stdout, file

# ============================================
# URLS
# ============================================
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000